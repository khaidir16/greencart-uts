{
  "name": "greencart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GreenCart botanical commerce and software testing project",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c green,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @greencart/web",
    "dev:api": "npm run dev --workspace @greencart/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bdd": "cucumber-js --import tsx/esm --import \"features/step-definitions/**/*.ts\" \"features/**/*.feature\" --format progress --format json:docs/evidence/cucumber-report.json",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.0.0",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
